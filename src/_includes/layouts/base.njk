<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{ description or site.description }}" />
  <title>{{ title }} — {{ site.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&family=Petit+Formal+Script&family=Playwrite+CA:wght@100..400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/katex/katex.min.css" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <aside class="visual-rail" aria-label="Visual identity collage">
    <img src="/finalsidebar.png" alt="A collage of Karvy's programming tools" />
  </aside>

  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="{{ site.url }}">{{ site.name }}</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/rss.xml">RSS</a>
        <a href="https://karvys.dev">About</a>
        <a href="/">All writings</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>© {{ site.year }} {{ site.author }}</span>
      <span>Built with curiosity</span>
    </footer>
  </div>
</body>
</html>
