---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>

    <div class="post-meta" aria-label="Post metadata">
      <time datetime="{{ date | htmlDate }}">{{ date | readableDate }}</time>
      {% if categories %}
        <div class="post-categories" aria-label="Categories">
          {% for category in categories %}
            <a class="post-category" href="/categories/{{ category | slugify }}/">{{ category }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </header>

  {{ content | safe }}

  {% set related = collections.posts | relatedPosts(page.url, categories) %}
  {% if related.length %}
    <footer class="post-footer">
      <h2>More...</h2>
      <div class="recent-notes">
        {% for post in related %}
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        {% endfor %}
      </div>
    </footer>
  {% endif %}
</article>
