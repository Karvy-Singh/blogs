---
layout: layouts/base.njk
title: All writings
description: Notes about software, tools, and thoughtful workflows.
permalink: index.html
---
<article class="post writing-index">
  <h1>All writings</h1>
  <div class="writing-list">
    {% for post in collections.posts %}
      <article>
        <time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>
</article>
